{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vapi call_ended Webhook Payload",
  "description": "Shape of the POST body sent by Vapi to n8n on call completion",
  "type": "object",
  "required": ["message"],
  "properties": {
    "message": {
      "type": "object",
      "required": ["type", "call", "transcript"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["end-of-call-report"],
          "description": "Must be end-of-call-report to trigger SOPBot pipeline"
        },
        "call": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "description": "Vapi call UUID — used as idempotency key" },
            "startedAt": { "type": "string", "format": "date-time" },
            "endedAt": { "type": "string", "format": "date-time" },
            "durationSeconds": { "type": "number" },
            "phoneNumber": { "type": "string", "description": "Inbound number called" },
            "customer": {
              "type": "object",
              "properties": {
                "number": { "type": "string", "description": "Caller's phone number" }
              }
            }
          }
        },
        "transcript": {
          "type": "string",
          "description": "Full plain-text transcript of the call"
        },
        "summary": {
          "type": "string",
          "description": "Optional Vapi-generated summary (not used by SOPBot)"
        }
      }
    }
  }
}
