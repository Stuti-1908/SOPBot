# ============================================================
# INFRA — copy to .env and fill in real values
# NEVER commit .env to git
# ============================================================

# --- Domains ---
# Co-hosted on the existing "relentless-n8n" server (shared Caddy at /root/n8n).
# Using free nip.io wildcard DNS — no domain purchase needed.
# Server IP: 167.233.94.171
N8N_HOST=dada-n8n.167.233.94.171.nip.io
WIQ_HOST=dada-wiq.167.233.94.171.nip.io

# --- n8n ---
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX

# --- Postgres (separate DB from the existing project's n8n) ---
POSTGRES_DB=dadaai_n8n
POSTGRES_USER=dadaai_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google Service Account ---
# Path to JSON key file on the HOST server (mounted read-only into the container)
GCP_SA_HOST_PATH=/root/dadaai/secrets/gcp_sa.json

# --- Airtable ---
AIRTABLE_API_TOKEN=patCHANGE_ME
AIRTABLE_BASE_ID=appCHANGE_ME

# --- WorkflowIQ ---
STREAMLIT_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MAX_SOP_WORDS=15000
MIN_SOP_WORDS=100
MAX_SOPS_PER_RUN=30

# --- GHL (GoHighLevel) ---
GHL_API_KEY=CHANGE_ME
GHL_LOCATION_ID=CHANGE_ME
GHL_NOTIFICATION_EMAIL_DWAYNE=dwayne@digital-dada.com
GHL_NOTIFICATION_EMAIL_STUTI=stuti.digitaldada@gmail.com

# --- Vapi ---
VAPI_WEBHOOK_SECRET=CHANGE_ME_32_BYTE_HEX
