{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOPBot Claude Extraction Output",
  "description": "JSON schema for Claude's transcript→SOP extraction response",
  "type": "object",
  "required": ["process_name", "steps"],
  "properties": {
    "process_name": { "type": "string" },
    "department": { "type": ["string", "null"] },
    "process_owner": { "type": ["string", "null"] },
    "frequency": { "type": ["string", "null"] },
    "estimated_duration_minutes": { "type": ["integer", "null"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_number", "title", "description"],
        "properties": {
          "step_number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tools_used": { "type": "array", "items": { "type": "string" } },
          "decision_points": { "type": "array", "items": { "type": "string" } },
          "pain_points": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "systems_used": { "type": "array", "items": { "type": "string" } },
    "exceptions": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": ["string", "null"] }
  }
}
