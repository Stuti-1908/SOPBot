          "jsCode": "const NL = String.fromCharCode(10);\nconst data = $('8. Parse Claude JSON').item.json;\n\nfunction esc(s) { return (s === null || s === undefined) ? '' : String(s); }\n\nconst stepsBlock = (data.steps || []).map(function(s) {\n  const tools = (s.tools_used || []).join(', ') || 'None specified';\n  const notes = [].concat(s.decision_points || [], s.pain_points || [], s.common_errors || []).map(function(x){ return typeof x === 'string' ? x : JSON.stringify(x); }).join('; ') || 'None';\n  const done = s.completion_indicator || 'Not specified';\n  const parts = [\n    'Step ' + s.step_number + ': ' + esc(s.action || s.title),\n    'Tools: ' + tools,\n    'Notes: ' + notes,\n    'Done when: ' + done\n  ];\n  return parts.join(NL);\n}).join(NL + NL);\n\nconst toolsSet = new Set();\n(data.steps || []).forEach(function(s) { (s.tools_used || []).forEach(function(t) { toolsSet.add(t); }); });\n(data.tools_and_resources || []).forEach(function(t) { toolsSet.add(t); });\nconst toolsList = Array.from(toolsSet).join(', ') || 'None specified';\n\nconst exceptionHandling = (data.exception_handling || []).length\n  ? data.exception_handling.map(function(e) {\n      return typeof e === 'string' ? e : ('If ' + (e.if || e.condition) + ': ' + (e.then || e.action));\n    }).join(NL)\n  : 'None captured during this call.';\n\nconst today = new Date().toISOString().slice(0, 10);\n\nreturn [{\n  json: {\n    doc_name: esc(data.process_name) + ' â€” ' + esc(data.employee_name) + ' â€” ' + today,\n    tokens: {\n      '{{COMPANY_NAME}}': esc(data.company_name),\n      '{{PROCESS_NAME}}': esc(data.process_name),\n      '{{EMPLOYEE_ROLE}}': esc(data.employee_role),\n      '{{EMPLOYEE_NAME}}': esc(data.employee_name),\n      '{{EMPLOYEE_TENURE}}': esc(data.employee_tenure),\n      '{{DATE}}': today,\n      '{{PROCESS_FREQUENCY}}': esc(data.frequency || data.process_frequency),\n      '{{ROLE_SUMMARY}}': esc(data.role_summary),\n      '{{PROCESS_TRIGGER}}': esc(data.process_trigger),\n      '{{TOOLS_LIST}}': toolsList,\n      '{{STEPS_BLOCK}}': stepsBlock || 'No steps captured.',\n      '{{EXCEPTION_HANDLING}}': exceptionHandling,\n      '{{COMPLETION_CRITERIA}}': esc(data.completion_criteria),\n      '{{INSIDER_NOTES}}': esc(data.insider_notes || data.notes)\n    }\n  }\n}];\n"
        },
