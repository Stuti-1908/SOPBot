          "jsCode": "const body = $input.first().json.body || {};\nconst msg = body.message || {};\nconst call = msg.call || {};\n\n// Real Vapi end-of-call-report puts startedAt/endedAt/duration/transcript at the TOP level of `message`,\n// not nested under `message.call` (the spec doc's example payload was not accurate to the live schema).\n// Fallbacks to call.* are kept in case a future Vapi version or a different event type nests them there.\nconst startedAt = msg.startedAt || call.startedAt || '';\nconst endedAt = msg.endedAt || call.endedAt || '';\nconst durationSeconds = msg.durationSeconds || call.durationSeconds || 0;\nconst transcript = msg.transcript || '';\nconst customerNumber = (call.customer && call.customer.number) || (msg.customer && msg.customer.number) || '';\n\nreturn [{\n  json: {\n    call_id: call.id || msg.call?.id || '',\n    transcript: transcript,\n    started_at: startedAt,\n    ended_at: endedAt,\n    duration_seconds: durationSeconds,\n    customer_number: customerNumber\n  }\n}];"
