# Stripe (test mode keys first - never start with live keys, sk_test_... / whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL this service is reachable at (used for checkout success/cancel redirect URLs)
PUBLIC_BASE_URL=

# Supabase - reuses the same project as the dashboard
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# n8n webhook that emails a customer their dashboard link + PIN right after
# a SOPBot pack purchase (see fulfillment.py::_notify_customer_welcome)
CUSTOMER_WELCOME_WEBHOOK_URL=
CUSTOMER_WELCOME_WEBHOOK_SECRET=
WELCOME_EMAIL_FROM=

# n8n webhook that alerts staff a WorkflowIQ order needs running
# (see fulfillment.py::_notify_workflowiq_order)
WORKFLOWIQ_ORDER_WEBHOOK_URL=
WORKFLOWIQ_ORDER_WEBHOOK_SECRET=

# Shown in the welcome email as the number to give employees
SOPBOT_CALL_NUMBER=+1 903-626-7053

PORT=8080
