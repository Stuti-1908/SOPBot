      {
        "parameters": {
          "jsCode": "const raw = $input.first().json.content[0].text;\nlet cleaned = raw.trim();\n\n// Strip markdown code fences using plain string ops (avoids regex+backtick transport issues)\nconst fence = String.fromCharCode(96, 96, 96); // ```\nif (cleaned.startsWith(fence)) {\n  let rest = cleaned.slice(fence.length);\n  if (rest.toLowerCase().startsWith('json')) rest = rest.slice(4);\n  const firstNewline = rest.indexOf(String.fromCharCode(10));\n  if (firstNewline !== -1) rest = rest.slice(firstNewline + 1);\n  if (rest.endsWith(fence)) rest = rest.slice(0, -fence.length);\n  cleaned = rest.trim();\n}\n\n// Claude sometimes prefixes the JSON with a natural-language sentence (e.g. noting a\n// call was cut short) even when told to return JSON only. Extract the JSON object by\n// finding the first '{' and its balanced matching '}', ignoring any surrounding prose.\nfunction extractJsonObject(text) {\n  const start = text.indexOf('{');\n  if (start === -1) return null;\n  let depth = 0;\n  for (let i = start; i < text.length; i++) {\n    if (text[i] === '{') depth++;\n    else if (text[i] === '}') {\n      depth--;\n      if (depth === 0) return text.slice(start, i + 1);\n    }\n  }\n  return null;\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (firstErr) {\n  const extracted = extractJsonObject(cleaned);\n  if (!extracted) {\n    throw new Error('Claude returned invalid JSON and no JSON object could be located: ' + firstErr.message + ' | raw: ' + cleaned.slice(0, 500));\n  }\n  try {\n    parsed = JSON.parse(extracted);\n  } catch (secondErr) {\n    throw new Error('Claude returned invalid JSON even after extracting the object: ' + secondErr.message + ' | raw: ' + cleaned.slice(0, 500));\n  }\n}\nreturn [{ json: parsed }];"
        },
