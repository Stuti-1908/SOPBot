# WorkflowIQ environment — copy to .env (never commit .env)

ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/gcp_sa.json

OUTPUT_DIR=./output
MAX_SOP_WORDS=15000
MIN_SOP_WORDS=100
MAX_SOPS_PER_RUN=8

AIRTABLE_API_TOKEN=patCHANGE_ME
AIRTABLE_BASE_ID=appCHANGE_ME
AIRTABLE_RUNS_TABLE=WorkflowIQ Runs

# Supabase - shared with dashboard/ and payments/, used to find pending
# WorkflowIQ orders and mark them delivered (see app/order_delivery.py)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# GHL - used to email the finished report to the customer once a run is
# tied to a pending order (see app/order_delivery.py::email_report_to_customer)
GHL_API_TOKEN=CHANGE_ME
GHL_LOCATION_ID=CHANGE_ME

STREAMLIT_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Model to use — pin to avoid surprise upgrades
ANTHROPIC_MODEL=claude-sonnet-4-6
